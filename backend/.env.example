NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional: set DNS resolvers if your local DNS proxy refuses MongoDB Atlas SRV lookups.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
